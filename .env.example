# Variable names only. Real values live in the environment or the keychain,
# never in a committed file (AGENTS.md). Copy to .env if you use a loader;
# .env is git-ignored and Claude Code is denied from reading it.

# --- Local CLI (src/jobagent) ---
# Data directory. Default: $XDG_DATA_HOME/jobagent or ~/.local/share/jobagent.
# Tests and manual runs should point this at a temp path.
JOBAGENT_DATA_DIR=

# --- Scheduled daily run (scripts/launchd, docs/scheduling.md) ---
# Set these in the plist's EnvironmentVariables, not here; listed for reference.
JOBAGENT_RUNTIME_DIR=
JOBAGENT_DAILY_SOURCES=
JOBAGENT_DAILY_LIMIT=
JOBAGENT_NOTIFY=

# --- Hosted companion, laptop side (jobagent sync, ADR 0010) ---
JOBAGENT_COMPANION_URL=
JOBAGENT_SYNC_TOKEN=
JOBAGENT_ACCESS_CLIENT_ID=
JOBAGENT_ACCESS_CLIENT_SECRET=

# --- Hosted companion, Cloudflare side (cloudflare/README.md) ---
# Deployment variables and secrets on the Pages project, never a file.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
OWNER_GITHUB_ID=
SESSION_SECRET=
SYNC_TOKEN=

# --- Synthetic dev deployment (cloudflare/scripts/deploy-dev.mjs) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FREE_TIER_ENABLED=
ACCOUNT_PLAN=
CF_DEV_PAGES_PROJECT=
CF_DEV_D1_DATABASE_ID=
CF_DEV_WRANGLER_CONFIG=
